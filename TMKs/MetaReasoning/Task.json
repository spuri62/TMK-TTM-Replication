{
  "model": "Task",
  "tasks": [
    {
      "name": "PerformMetaReasoning",
      "description": "Solve a reasoning or learning problem using meta-reasoning processes.",
      "inputParameters": [
        "problem: problem"
      ],
      "outputParameters": [
        "resolution: result"
      ],
      "given": "problem != null",
      "makes": "resolution != null",
      "means": [
        {
          "mechanismReference": "MetaReasoningSolution",
          "actualArguments": [
            "problem",
            "resolution"
          ]
        }
      ]
    },
    {
      "name": "DetectIssue",
      "description": "Detect an issue (error or gap) in a reasoning or learning problem.",
      "inputParameters": [
        "problem: problem"
      ],
      "outputParameters": [
        "issue: issue"
      ],
      "given": "problem != null",
      "makes": "issue != null",
      "means": [
        {
          "mechanismReference": "DetectIssueSolution",
          "actualArguments": [
            "problem",
            "issue"
          ]
        }
      ]
    },
    {
      "name": "ClassifyIssue",
      "description": "Classify a detected issue into {'Error','Gap'}.",
      "inputParameters": [
        "issue: issue"
      ],
      "outputParameters": [
        "issueType: type"
      ],
      "given": "issue != null",
      "makes": "issueType in {'Error','Gap'}",
      "means": [
        {
          "mechanismReference": "ClassifyIssueSolution",
          "actualArguments": [
            "issue",
            "issueType"
          ]
        }
      ]
    },
    {
      "name": "SpawnMetaGoal",
      "description": "Create a meta-level goal based on the classified issue type.",
      "inputParameters": [
        "issueType: type"
      ],
      "outputParameters": [
        "metaGoal: goal"
      ],
      "given": "issueType in {'Error','Gap'}",
      "makes": "metaGoal != null",
      "means": [
        {
          "mechanismReference": "SpawnMetaGoalSolution",
          "actualArguments": [
            "issueType",
            "metaGoal"
          ]
        }
      ]
    },
    {
      "name": "SelectStrategy",
      "description": "Choose the most appropriate reasoning strategy to achieve the meta-goal.",
      "inputParameters": [
        "metaGoal: goal"
      ],
      "outputParameters": [
        "selectedStrategy: strategy"
      ],
      "given": "metaGoal != null",
      "makes": "selectedStrategy != null",
      "means": [
        {
          "mechanismReference": "SelectStrategySolution",
          "actualArguments": [
            "metaGoal",
            "selectedStrategy"
          ]
        }
      ]
    },
    {
      "name": "IntegrateStrategies",
      "description": "Apply the selected strategy; if progress stalls, integrate or switch strategies to satisfy the meta-goal.",
      "inputParameters": [
        "selectedStrategy: strategy",
        "metaGoal: goal"
      ],
      "outputParameters": [
        "resolution: result"
      ],
      "given": "selectedStrategy != null && metaGoal != null",
      "makes": "resolution != null",
      "means": [
        {
          "mechanismReference": "IntegrateStrategiesSolution",
          "actualArguments": [
            "selectedStrategy",
            "metaGoal",
            "resolution"
          ]
        }
      ]
    },
    {
      "name": "Complete",
      "description": "Meta-reasoning process completed successfully.",
      "inputParameters": [],
      "outputParameters": [],
      "means": []
    },
    {
      "name": "FailureGoal",
      "description": "Meta-reasoning process failed.",
      "inputParameters": [],
      "outputParameters": [],
      "means": []
    }
  ]
}
