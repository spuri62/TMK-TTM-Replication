      "description": "Determine the principal characteristic group and suffix.",
      "inputParameters": [
        "initialConfiguration: configuration"
      ],
      "outputParameters": [
        "groupConfiguration: configuration"
      ],
      "means": [
        {
          "mechanismReference": "IdentifyPrincipalCharacteristicGroupMechanism",
          "actualArguments": [
            "initialConfiguration",
            "groupConfiguration"
          ]
        }
      ]
    },
    {
      "name": "SelectParentCompound",
