{
  "model": "Task",
  "tasks": [
    {
      "name": "NameOrganicCompound",
      "description": "Generate a systematic IUPAC name for an organic compound using substitutive nomenclature.",
      "inputParameters": [
        "initialConfiguration: configuration",
        "knowledgeBase: knowledgeBase"
      ],
      "outputParameters": [
        "finalConfiguration: configuration"
      ],
      "given": "validChemicalStructure(initialConfiguration)",
      "makes": "validSystematicName(finalConfiguration)",
      "means": [
        {
          "mechanismReference": "IUPACNomenclatureSolution",
          "actualArguments": [
            "initialConfiguration",
            "finalConfiguration"
          ]
        }
      ]
    },
    {
      "name": "IdentifyPrincipalCharacteristicGroup",
      "description": "Determine the principal characteristic group to be cited as the suffix based on seniority.",
      "inputParameters": [
        "initialConfiguration: configuration"
      ],
      "outputParameters": [
        "groupConfiguration: configuration"
      ],
      "given": "validChemicalStructure(initialConfiguration)",
      "makes": "principalGroupStepComplete(groupConfiguration)",
      "means": [
        {
          "mechanismReference": "IdentifyPrincipalCharacteristicGroupMechanism",
          "actualArguments": [
            "initialConfiguration",
            "groupConfiguration"
          ]
        }
      ]
    },
    {
      "name": "SelectParentCompound",
      "description": "Determine the senior parent amongst structural components attached to the principal characteristic group.",
      "inputParameters": [
        "groupConfiguration: configuration"
      ],
      "outputParameters": [
        "parentConfiguration: configuration"
      ],
      "given": "principalGroupStepComplete(groupConfiguration)",
      "makes": "seniorParentIdentified(parentConfiguration)",
      "means": [
        {
          "mechanismReference": "SelectParentCompoundMechanism",
          "actualArguments": [
            "groupConfiguration",
            "parentConfiguration"
          ]
        }
      ]
    },
    {
      "name": "NameParentHydrideAndUnsaturation",
      "description": "Name the parent hydride and specify any unsaturation (ene/yne endings).",
      "inputParameters": [
        "parentConfiguration: configuration"
      ],
      "outputParameters": [
        "parentConfiguration: configuration"
      ],
      "given": "seniorParentIdentified(parentConfiguration)",
      "makes": "parentNamed(parentConfiguration)",
      "means": [
        {
          "mechanismReference": "ParentNamingMechanism",
          "actualArguments": [
            "parentConfiguration"
          ]
        }
      ]
    },
    {
      "name": "CombineParentWithSuffix",
      "description": "Combine the name of the parent hydride with the suffix for the principal characteristic group.",
      "inputParameters": [
        "parentConfiguration: configuration"
      ],
      "outputParameters": [
        "parentConfiguration: configuration"
      ],
      "given": "parentNamed(parentConfiguration)",
      "makes": "parentAndSuffixCombined(parentConfiguration)",
      "means": [
        {
          "mechanismReference": "SuffixCombinationMechanism",
          "actualArguments": [
            "parentConfiguration"
          ]
        }
      ]
    },
    {
      "name": "AssignSubstituentsAndLocants",
      "description": "Identify substituents, add multiplicative prefixes, and assign locants to the complete structure, arranging the prefixes in alphabetical order.",
      "inputParameters": [
        "parentConfiguration: configuration"
      ],
      "outputParameters": [
        "substituentConfiguration: configuration"
      ],
      "given": "parentAndSuffixCombined(parentConfiguration)",
      "makes": "substituentsAndLocantsAssigned(substituentConfiguration)",
      "means": [
        {
          "mechanismReference": "AssignSubstituentsAndLocantsMechanism",
          "actualArguments": [
            "parentConfiguration",
            "substituentConfiguration"
          ]
        }
      ]
    },
    {
      "name": "AddStereodescriptors",
      "description": "Determine chirality centres and other stereogenic units and add stereodescriptors.",
      "inputParameters": [
        "substituentConfiguration: configuration"
      ],
      "outputParameters": [
        "finalConfiguration: configuration"
      ],
      "given": "substituentsAndLocantsAssigned(substituentConfiguration)",
      "makes": "stereochemistryAssigned(finalConfiguration)",
      "means": [
        {
          "mechanismReference": "StereochemistryMechanism",
          "actualArguments": [
            "substituentConfiguration",
            "finalConfiguration"
          ]
        }
      ]
    },
    {
      "name": "ConstructSystematicName",
      "description": "Assemble the complete systematic name including stereodescriptors if present.",
      "inputParameters": [
        "finalConfiguration: configuration"
      ],
      "outputParameters": [
        "finalConfiguration: configuration"
      ],
      "given": "stereochemistryAssigned(finalConfiguration)",
      "makes": "validSystematicName(finalConfiguration)",
      "means": [
        {
          "mechanismReference": "ConstructSystematicNameMechanism",
          "actualArguments": [
            "finalConfiguration"
          ]
        }
      ]
    },
    {
      "name": "FailureGoal",
      "description": "Naming process failed.",
      "inputParameters": [],
      "outputParameters": [],
      "given": "true",
      "makes": "failed(configuration)",
      "means": []
    },
    {
      "name": "Complete",
      "description": "Naming process completed.",
      "inputParameters": [],
      "outputParameters": [],
      "given": "true",
      "makes": "completed(configuration)",
      "means": []
    }
  ]
}
