{
  "model": "Method",
  "methods": [
    {
      "name": "IUPACNomenclatureSolution",
      "description": "Main FSM for systematic IUPAC naming following the Blue Book sequence.",
      "inputParameters": [
        "initialConfiguration: configuration"
      ],
      "outputParameters": [
        "finalConfiguration: configuration"
      ],
      "organizer": {
        "startState": "S0",
        "successState": "S7",
        "failureState": "Fail",
        "states": [
          {
            "name": "S0",
            "goalInvocation": {
              "goalReference": "IdentifyPrincipalCharacteristicGroup",
              "type": "operation",
              "actualArguments": [
                "initialConfiguration",
                "groupConfiguration"
              ]
            }
          },
          {
            "name": "S1",
            "goalInvocation": {
              "goalReference": "SelectParentCompound",
              "type": "operation",
              "actualArguments": [
                "groupConfiguration",
                "parentConfiguration"
              ]
            }
          },
          {
            "name": "S2",
            "goalInvocation": {
              "goalReference": "NameParentHydrideAndUnsaturation",
              "type": "operation",
              "actualArguments": [
                "parentConfiguration"
              ]
            }
          },
          {
            "name": "S3",
            "goalInvocation": {
              "goalReference": "CombineParentWithSuffix",
              "type": "operation",
              "actualArguments": [
                "parentConfiguration"
              ]
            }
          },
          {
            "name": "S4",
            "goalInvocation": {
              "goalReference": "AssignSubstituentsAndLocants",
              "type": "operation",
              "actualArguments": [
                "parentConfiguration",
                "substituentConfiguration"
              ]
            }
          },
          {
            "name": "S5",
            "goalInvocation": {
              "goalReference": "AddStereodescriptors",
              "type": "operation",
              "actualArguments": [
                "substituentConfiguration",
                "finalConfiguration"
              ]
            }
          },
          {
            "name": "S6",
            "goalInvocation": {
              "goalReference": "ConstructSystematicName",
              "type": "operation",
              "actualArguments": [
                "finalConfiguration"
              ]
            }
          },
          {
            "name": "S7",
            "goalInvocation": {
              "goalReference": "Complete",
              "type": "task",
              "actualArguments": []
            }
          },
          {
            "name": "Fail",
            "goalInvocation": {
              "goalReference": "FailureGoal",
              "type": "task",
              "actualArguments": []
            }
          }
        ],
        "transitions": [
          {
            "sourceState": "S0",
            "targetState": "S1",
            "dataCondition": "!isEmpty(groupConfiguration)"
          },
          {
            "sourceState": "S1",
            "targetState": "S2",
            "dataCondition": "!isEmpty(parentConfiguration)"
          },
          {
            "sourceState": "S2",
            "targetState": "S3",
            "dataCondition": "parentNamed(parentConfiguration)"
          },
          {
            "sourceState": "S3",
            "targetState": "S4",
            "dataCondition": "parentAndSuffixCombined(parentConfiguration)"
          },
          {
            "sourceState": "S4",
            "targetState": "S5",
            "dataCondition": "!isEmpty(substituentConfiguration)"
          },
          {
            "sourceState": "S5",
            "targetState": "S6",
            "dataCondition": "!isEmpty(finalConfiguration)"
          },
          {
            "sourceState": "S6",
            "targetState": "S7",
            "dataCondition": "goodNomenclature(finalConfiguration)"
          }
        ]
      }
    },
    {
      "name": "IdentifyPrincipalCharacteristicGroupMechanism",
      "description": "Determine highest seniority functional group.",
      "inputParameters": [
        "initialConfiguration: configuration"
      ],
      "outputParameters": [
        "groupConfiguration: configuration"
      ]
    },
    {
      "name": "SelectParentCompoundMechanism",
      "description": "Choose senior parent hydride and specify unsaturation.",
      "inputParameters": [
        "groupConfiguration: configuration"
      ],
      "outputParameters": [
        "parentConfiguration: configuration"
      ]
    },
    {
      "name": "AssignSubstituentsAndLocantsMechanism",
      "description": "Assign prefixes, multiplicative prefixes, alphabetical order and locants.",
      "inputParameters": [
        "parentConfiguration: configuration"
      ],
      "outputParameters": [
        "substituentConfiguration: configuration"
      ]
    },
    {
      "name": "ConstructSystematicNameMechanism",
      "description": "Combine parent, suffix, prefixes, locants and stereodescriptors into final name.",
      "inputParameters": [
        "finalConfiguration: configuration"
      ],
      "outputParameters": [
        "finalConfiguration: configuration"
      ]
    }
  ]
}
