        {
          "mechanismReference": "PerformVisuospatialReasoningMechanism",
          "actualArguments": [
            "initialConfiguration",
            "visuospatialConfiguration"
          ]
        }
      ]
    },
    {
      "name": "PerformSystemsThinking",
