{
  "model": "Task",
  "tasks": [
    {
      "name": "UnderstandUsingFrames",
      "description": "Understand the meaning of a natural language sentence using frames, including stereotypical situations, default slot values, and implied consequences.",
      "inputParameters": [
        "sentence: string",
        "knowledgeBase: knowledgeBase"
      ],
      "outputParameters": [
        "interpretation: frameNetwork"
      ],
      "given": "sentence != null",
      "makes": "interpretation reflects the explicit and implicit meaning conveyed by sentence",
      "means": [
        {
          "mechanismReference": "ReasonUsingFrames",
          "actualArguments": [
            "sentence",
            "knowledgeBase",
            "interpretation"
          ]
        }
      ]
    },
    {
      "name": "IdentifyFrame",
      "description": "Identify the frame associated with the main action or concept in a sentence.",
      "inputParameters": [
        "sentence: string"
      ],
      "outputParameters": [
        "frame: frame"
      ],
      "given": "sentence != null",
      "makes": "frame corresponds to the main action or concept expressed in sentence",
      "means": [
        {
          "mechanismReference": "IdentifyFrameMechanism",
          "actualArguments": [
            "sentence",
            "frame"
          ]
        }
      ]
    },
    {
      "name": "FillSlots",
      "description": "Populate frame slots using information extracted from a sentence.",
      "inputParameters": [
        "frame: frame",
        "sentence: string"
      ],
      "outputParameters": [
        "filledFrame: frame"
      ],
      "given": "frame != null AND sentence != null",
      "makes": "filledFrame contains slot values derived from sentence",
      "means": [
        {
          "mechanismReference": "FillSlotsMechanism",
          "actualArguments": [
            "frame",
            "sentence",
            "filledFrame"
          ]
        }
      ]
    },
    {
      "name": "ApplyDefaults",
      "description": "Apply default slot fillers associated with a frame stereotype.",
      "inputParameters": [
        "filledFrame: frame"
      ],
      "outputParameters": [
        "completedFrame: frame"
      ],
      "given": "filledFrame != null",
      "makes": "completedFrame includes explicit slot values and applicable defaults",
      "means": [
        {
          "mechanismReference": "ApplyDefaultsMechanism",
          "actualArguments": [
            "filledFrame",
            "completedFrame"
          ]
        }
      ]
    },
    {
      "name": "MakeInferences",
      "description": "Use frame slot values and defaults to derive common-sense implications.",
      "inputParameters": [
        "completedFrame: frame"
      ],
      "outputParameters": [
        "interpretation: frameNetwork"
      ],
      "given": "completedFrame != null",
      "makes": "interpretation reflects implications supported by completedFrame",
      "means": [
        {
          "mechanismReference": "ReasonUsingFrames",
          "actualArguments": [
            "completedFrame",
            "interpretation"
          ]
        }
      ]
    },
    {
      "name": "Complete",
      "description": "Frame interpretation completed successfully.",
      "inputParameters": [],
      "outputParameters": [],
      "means": []
    },
    {
      "name": "FailureGoal",
      "description": "Frame interpretation failed.",
      "inputParameters": [],
      "outputParameters": [],
      "means": []
    }
  ]
}
