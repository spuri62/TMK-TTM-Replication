{
  "model": "Knowledge",
  "concepts": [
    {
      "name": "frame",
      "description": "A mental structure for representing a stereotypical situation composed of slots and fillers."
    },
    {
      "name": "slot",
      "description": "A component of a frame representing an attribute or relation, with a corresponding value (filler).",
      "properties": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "default",
          "type": "value"
        },
        {
          "name": "proceduralAttachment",
          "type": "function"
        }
      ]
    },
    {
      "name": "filler",
      "description": "A value or sub-frame that fits into a specific slot."
    },
    {
      "name": "stereotype",
      "description": "Typical knowledge associated with a situation."
    },
    {
      "name": "sentence",
      "description": "Natural language input interpreted using frames."
    },
    {
      "name": "configuration",
      "description": "The current state of slot-filler assignments in a frame."
    },
    {
      "name": "inference",
      "description": "Common-sense conclusion derived from a frame."
    },
    {
      "name": "percept",
      "description": "A piece of sensory information or data point from the environment."
    },
    {
      "name": "frameNetwork",
      "description": "A network of frames linked by slot-filler (key-value) relations."
    },
    {
      "name": "image",
      "description": "Visual input representing structured percepts, e.g. an RPM cell."
    },
    {
      "name": "text",
      "description": "Unstructured natural language data."
    },
    {
      "name": "shape",
      "description": "Geometric object in RPM problems",
      "properties": [
        "name",
        "type",
        "size",
        "fill",
        "inside",
        "above"
      ]
    },
    {
      "name": "newsStory",
      "description": "A representation of a news story documenting an event.",
      "properties": [
        "day",
        "location",
        "damage",
        "fatalities",
        "faultline",
        "magnitude",
        "time",
        "type",
        "duration"
      ]
    }
  ],

