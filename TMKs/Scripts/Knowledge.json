{
  "model": "Knowledge",
  "concepts": [
    {
      "name": "script",
      "description": "Knowledge representation for a causally coherent set of events with six main components: entry conditions, results, props, roles, tracks, and scenes.",
      "properties": [
        {
          "name": "entryConditions",
          "type": "entryCondition"
        },
        {
          "name": "results",
          "type": "result"
        },
        {
          "name": "props",
          "type": "list[prop]"
        },
        {
          "name": "roles",
          "type": "list[role]"
        },
        {
          "name": "tracks",
          "type": "list[track]"
        },
        {
          "name": "scenes",
          "type": "list[scene]"
        }
      ]
    },
    {
      "name": "entryCondition",
      "description": "Conditions necessary for executing a script, representing prerequisites that must be satisfied before script activation.",
      "properties": [
        {
          "name": "agentState",
          "type": "object"
        },
        {
          "name": "environmentalState",
          "type": "object"
        },
        {
          "name": "resourceAvailability",
          "type": "list"
        },
        {
          "name": "satisfactionRequirement",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "result",
      "description": "Conditions that become true after script execution, representing expected outcomes.",
      "properties": [
        {
          "name": "agentStateChanges",
          "type": "object"
        },
        {
          "name": "environmentalChanges",
          "type": "object"
        },
        {
          "name": "resourceTransfers",
          "type": "list"
        },
        {
          "name": "satisfactionStates",
          "type": "object"
        }
      ]
    },
    {
      "name": "prop",
      "description": "Objects involved in execution of a script.",
      "properties": [
        {
          "name": "objectType",
          "type": "string"
        },
        {
          "name": "function",
          "type": "string"
        },
        {
          "name": "location",
          "type": "string"
        }
      ]
    },
    {
      "name": "role",
      "description": "Agents participating in a script.",
      "properties": [
        {
          "name": "agentType",
          "type": "string"
        },
        {
          "name": "responsibilities",
          "type": "list"
        },
        {
          "name": "capabilities",
          "type": "list"
        }
      ]
    },
    {
      "name": "track",
      "description": "Variation or subclass of a script representing a specialization.",
      "properties": [
        {
          "name": "scriptType",
          "type": "string"
        },
        {
          "name": "specificConditions",
          "type": "object"
        },
        {
          "name": "specializedEvents",
          "type": "list"
        }
      ]
    },
    {
      "name": "scene",
      "description": "Specific sequence of events within a script.",
      "properties": [
        {
          "name": "eventSequence",
          "type": "orderedList"
        },
        {
          "name": "participants",
          "type": "list[role]"
        },
        {
          "name": "actions",
          "type": "list"
        },
        {
          "name": "preconditions",
          "type": "object"
        },
        {
          "name": "postconditions",
          "type": "object"
        }
      ]
    },
    {
      "name": "event",
      "description": "Observable action or state change in the world.",
      "properties": [
        {
          "name": "actor",
          "type": "string"
        },
        {
          "name": "action",
          "type": "string"
        },
        {
          "name": "object",
          "type": "string"
        },
        {
          "name": "preconditions",
          "type": "object"
        },
        {
          "name": "postconditions",
          "type": "object"
        }
      ]
    },
    {
      "name": "expectation",
