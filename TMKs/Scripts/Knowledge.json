        },
        {
          "name": "gapFilling",
          "type": "process"
        },
        {
          "name": "causalReasoning",
          "type": "process"
        },
        {
          "name": "situationClassification",
          "type": "process"
        },
        {
          "name": "scriptInstantiation",
          "type": "process"
        },
        {
          "name": "inferenceGeneration",
          "type": "process"
        }
      ]
    },
