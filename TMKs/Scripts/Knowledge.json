      "properties": [
        {
          "name": "predictionMechanism",
          "type": "process"
        },
        {
          "name": "defaultAssumptions",
          "type": "list"
        },
        {
          "name": "violationDetection",
          "type": "process"
        },
        {
          "name": "emotionalResponses",
          "type": "list"
        }
      ]
    },
    {
      "name": "configuration",
